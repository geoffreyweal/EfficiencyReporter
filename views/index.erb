<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Job Efficiency<%= @cluster_name.empty? ? "" : " · #{ERB::Util.h(@cluster_name)}" %></title>
  <link rel="icon" type="image/svg+xml" href="<%= ERB::Util.h(@base) %>/assets/favicon.svg?v=<%= ERB::Util.h(@version) %>">
  <link rel="stylesheet" href="<%= ERB::Util.h(@base) %>/assets/app.css?v=<%= ERB::Util.h(@version) %>">
</head>
<body data-base="<%= ERB::Util.h(@base) %>">
  <header class="topbar">
    <div class="topbar-inner">
      <div class="brand">
        <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5M4 19h16M8 15l3-4 3 2 5-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <h1>Job Efficiency</h1>
      </div>
      <nav class="topbar-links" id="topbar-links" aria-label="Page"></nav>
    </div>
  </header>

  <main id="app" class="page">
    <noscript><p class="notice">This page needs JavaScript.</p></noscript>
    <p class="loading-line" id="initial-loading">Loading your jobs&hellip;</p>
  </main>

  <script type="application/json" id="er-config"><%= @ui_json %></script>
  <script src="<%= ERB::Util.h(@base) %>/assets/app.js?v=<%= ERB::Util.h(@version) %>" defer></script>
</body>
</html>
